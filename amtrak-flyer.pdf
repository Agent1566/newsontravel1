<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amtrak Travel — Newson Travel</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <header class="site-header">
        <nav class="nav">
            <a href="index.html" class="logo">
                <img src="logo.png" alt="Newson Travel" class="logo-img">
            </a>
            <button class="nav-toggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
            <ul class="nav-links">
                <li><a href="index.html">Home</a></li>
                <li><a href="index.html#destinations">Destinations</a></li>
                <li><a href="air.travel.html">Air Travel</a></li>
                <li><a href="cruises.html">Cruises</a></li>
                <li><a href="car-rentals.html">Car Rentals</a></li>
                <li><a href="group.travel.html">Group Travel</a></li>
                <li><a href="honeymoon.html">Honeymoon</a></li>
                <li><a href="hotels.html">Hotels</a></li>
                <li><a href="resorts.html">Resorts</a></li>
                <li><a href="rail-travel.html">Rail Travel</a></li>
                <li><a href="travel-inspiration.html">Inspiration</a></li>
                <li><a href="index.html#about">About</a></li>
                <li><a href="index.html#contact" class="nav-cta">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section class="hero" style="min-height: 60vh; background: linear-gradient(160deg, #8A9A7B 0%, #D4A574 50%, #C17B5A 100%);">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <p class="hero-eyebrow">Scenic Rail Journeys</p>
            <h1 class="hero-title" style="font-size: clamp(2rem, 5vw, 3.5rem);">Amtrak Travel</h1>
            <p class="hero-subtitle" style="color: rgba(255,252,247,0.9);">Sit back, relax, and watch the autumn landscape roll by from the comfort of a train.</p>
            <div class="hero-actions">
                <a href="amtrak-flyer.pdf" target="_blank" class="btn btn-primary">📄 View Amtrak Flyer</a>
                <a href="index.html#contact" class="btn btn-ghost" style="color: var(--white); border-color: rgba(255,252,247,0.4);">Contact Us</a>
            </div>
        </div>
    </section>

    <section class="intro" style="padding-top: 60px;">
        <div class="container">
            <div class="section-head">
                <p class="section-eyebrow">Why Travel by Train</p>
                <h2 class="section-title">The Joy of Rail Travel</h2>
                <p class="section-desc">No traffic, no airport lines — just wide windows and beautiful scenery.</p>
            </div>
            <div class="intro-grid">
                <div class="intro-card">
                    <div class="intro-icon">🪟</div>
                    <h3>Scenic Views</h3>
                    <p>Large windows and panoramic cars showcase landscapes you can't see from the highway.</p>
                </div>
                <div class="intro-card">
                    <div class="intro-icon">🛋️</div>
                    <h3>Comfort & Space</h3>
                    <p>Roomy seats, legroom, and the freedom to walk around, dine, and relax onboard.</p>
                </div>
                <div class="intro-card">
                    <div class="intro-icon">🌿</div>
                    <h3>Eco-Friendly</h3>
                    <p>Trains produce up to 80% less emissions than flying or driving — travel greener.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="destinations">
        <div class="container">
            <div class="section-head">
                <p class="section-eyebrow">Popular Routes</p>
                <h2 class="section-title">Iconic Amtrak Routes</h2>
                <p class="section-desc">America's most beautiful train journeys — especially in autumn.</p>
            </div>
            <div class="dest-grid">
                <article class="dest-card">
                    <div class="dest-image" style="background: linear-gradient(135deg, #C17B5A, #8A9A7B);">
                        <div class="dest-image-inner"><span class="dest-emoji">🍂</span></div>
                    </div>
                    <div class="dest-body">
                        <span class="dest-tag">Autumn Favorite</span>
                        <h3>Adirondack</h3>
                        <p>New York City to Montreal through the spectacular fall foliage of the Hudson Valley and Adirondacks.</p>
                        <div class="dest-meta"><span>⏱ 10 hours</span><span>🍂 Peak: Oct</span></div>
                    </div>
                </article>
                <article class="dest-card">
                    <div class="dest-image" style="background: linear-gradient(135deg, #8A9A7B, #D4A574);">
                        <div class="dest-image-inner"><span class="dest-emoji">🏔️</span></div>
                    </div>
                    <div class="dest-body">
                        <span class="dest-tag">Scenic</span>
                        <h3>Coast Starlight</h3>
                        <p>Seattle to Los Angeles along the stunning Pacific coastline — mountains, forests, and ocean views.</p>
                        <div class="dest-meta"><span>⏱ 35 hours</span><span>🌊 Pacific Coast</span></div>
                    </div>
                </article>
                <article class="dest-card">
                    <div class="dest-image" style="background: linear-gradient(135deg, #D4A574, #C17B5A);">
                        <div class="dest-image-inner"><span class="dest-emoji">🏜️</span></div>
                    </div>
                    <div class="dest-body">
                        <span class="dest-tag">Epic Journey</span>
                        <h3>Southwest Chief</h3>
                        <p>Chicago to Los Angeles through the heart of the American Southwest and its red rock canyons.</p>
                        <div class="dest-meta"><span>⏱ 43 hours</span><span>🏜️ 8 states</span></div>
                    </div>
                </article>
                <article class="dest-card">
                    <div class="dest-image" style="background: linear-gradient(135deg, #B8860B, #8A9A7B);">
                        <div class="dest-image-inner"><span class="dest-emoji">🌄</span></div>
                    </div>
                    <div class="dest-body">
                        <span class="dest-tag">Most Scenic</span>
                        <h3>California Zephyr</h3>
                        <p>Chicago to San Francisco through the Rockies and Sierra Nevada — America's most beautiful train ride.</p>
                        <div class="dest-meta"><span>⏱ 52 hours</span><span>🏔️ Mountains</span></div>
                    </div>
                </article>
                <article class="dest-card">
                    <div class="dest-image" style="background: linear-gradient(135deg, #C17B5A, #B8860B);">
                        <div class="dest-image-inner"><span class="dest-emoji">🌃</span></div>
                    </div>
                    <div class="dest-body">
                        <span class="dest-tag">East Coast</span>
                        <h3>Northeast Regional</h3>
                        <p>Boston to Washington D.C. — connecting the historic cities of the East Coast with ease.</p>
                        <div class="dest-meta"><span>⏱ 8 hours</span><span>🏙️ Multiple stops</span></div>
                    </div>
                </article>
                <article class="dest-card">
                    <div class="dest-image" style="background: linear-gradient(135deg, #8A9A7B, #C17B5A);">
                        <div class="dest-image-inner"><span class="dest-emoji">🌊</span></div>
                    </div>
                    <div class="dest-body">
                        <span class="dest-tag">Fast</span>
                        <h3>Acela Express</h3>
                        <p>High-speed service from Boston to D.C. — business class luxury at 150 mph.</p>
                        <div class="dest-meta"><span>⏱ 7 hours</span><span>⚡ High-speed</span></div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="services">
        <div class="container">
            <div class="section-head">
                <p class="section-eyebrow">Amtrak Resources</p>
                <h2 class="section-title">Flyers & Guides</h2>
                <p class="section-desc">Download our Amtrak travel resources for special offers and route information.</p>
            </div>
            <div class="services-grid">
                <a href="amtrak-flyer.pdf" target="_blank" class="service-card">
                    <div class="service-icon">📄</div>
                    <h3>Amtrak Flyer</h3>
                    <p>Current Amtrak special offers and promotions.</p>
                </a>
                <a href="amtrak2-travel.html" class="service-card">
                    <div class="service-icon">🚆</div>
                    <h3>Amtrak Routes & Passes</h3>
                    <p>Explore rail passes and multi-route options.</p>
                </a>
                <a href="amtrak3-travel.html" class="service-card">
                    <div class="service-icon">🎫</div>
                    <h3>Amtrak Tips & Booking</h3>
                    <p>Tips for booking, seating, and making the most of your journey.</p>
                </a>
            </div>
        </div>
    </section>

    <section class="contact">
        <div class="container">
            <div class="contact-card">
                <div class="contact-text">
                    <p class="section-eyebrow">All Aboard</p>
                    <h2 class="section-title">Plan Your Train Journey</h2>
                    <p>Tell us where you'd like to go by rail. We'll find the best routes, fares, and schedules for you.</p>
                </div>
                <form class="contact-form" onsubmit="event.preventDefault(); this.querySelector('.form-success').classList.add('show'); this.querySelector('button').textContent='Sent! ✓';">
                    <input type="text" placeholder="Your name" required>
                    <input type="email" placeholder="Email address" required>
                    <input type="text" placeholder="Departure city">
                    <input type="text" placeholder="Destination city">
                    <textarea placeholder="Tell us about your ideal train journey..." rows="3"></textarea>
                    <button type="submit" class="btn btn-primary">Send Inquiry</button>
                    <p class="form-success">Thank you! We'll be in touch within 48 hours. 🚆</p>
                </form>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <a href="index.html" class="logo"><span class="logo-mark">🍂</span><span class="logo-text">Newson Travel</span></a>
                <p>Soft journeys, golden horizons. Curated autumn travel experiences since 2014.</p>
            </div>
            <div class="footer-links">
                <h4>Travel Services</h4>
                <a href="air.travel.html">Air Travel</a>
                <a href="cruises.html">Cruises</a>
                <a href="car-rentals.html">Car Rentals</a>
                <a href="hotels.html">Hotels</a>
                <a href="resorts.html">Resorts</a>
                <a href="rail-travel.html">Rail Travel</a>
            </div>
            <div class="footer-links">
                <h4>More</h4>
                <a href="group.travel.html">Group Travel</a>
                <a href="honeymoon.html">Honeymoons</a>
                <a href="travel-inspiration.html">Inspiration</a>
                <a href="qoute-request.html">Request a Quote</a>
                <a href="index.html#about">About Us</a>
                <a href="index.html#contact">Contact</a>
            </div>
            <div class="footer-links">
                <h4>Cruise Lines</h4>
                <a href="ncl-cruise.html">Norwegian Cruise Line</a>
                <a href="royal-caribbean.html">Royal Caribbean</a>
                <a href="virgin-voyage.html">Virgin Voyages</a>
                <a href="carinval cruise.flyer.pdf" target="_blank">Carnival Flyer</a>
                <a href="amtrak-flyer.pdf" target="_blank">Amtrak Flyer</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Newson Travel. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const navToggle = document.querySelector('.nav-toggle');
        const navLinks = document.querySelector('.nav-links');
        navToggle.addEventListener('click', () => { navLinks.classList.toggle('open'); navToggle.classList.toggle('active'); });
        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', e => {
                const target = document.querySelector(a.getAttribute('href'));
                if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); navLinks.classList.remove('open'); navToggle.classList.remove('active'); }
            });
        });
    </script>
</body>
</html>
